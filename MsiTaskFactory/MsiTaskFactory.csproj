<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AssemblyName>MSBuild.ExtensionPack.MsiTaskFactory</AssemblyName>
    <AssemblyOriginatorKeyFile>D:\GitHub\MSBuildExtensionPack\Common\RamTunedMegaCode.public.snk</AssemblyOriginatorKeyFile>
    <Authors>John Merryweather Cooper,  Mike Fourie</Authors>
    <Company>Ram Tuned Mega Code</Company>
    <Copyright>Copyright (c) 2008-2025, John Merryweather Cooper.  All Rights Reserved.</Copyright>
    <DelaySign>True</DelaySign>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <IncludeSymbols>True</IncludeSymbols>
    <NuGetAuditMode>all</NuGetAuditMode>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jmcooper176/MSBuildExtensionPack</PackageProjectUrl>
    <Product>MSBuild Extension Pack 6.0</Product>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jmcooper176/MSBuildExtensionPack.git</RepositoryUrl>
    <RootNamespace>MSBuild.ExtensionPack.MsiTaskFactory</RootNamespace>
    <SignAssembly>True</SignAssembly>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>MSBuild Extension Pack MSI Task Factory</Title>
    <Version>6.0.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\COMTaskFactory\COMTaskFactory.csproj" />
  </ItemGroup>

</Project>
